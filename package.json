{
  "name": "sili-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "playwright test",
    "build:preview": "vite build --mode runtime-preview --outDir tmp/runtime-preview/site/dist",
    "assets:export": "node scripts/prepare-regenerated.mjs && node scripts/trace-regenerated.mjs",
    "assets:check": "node scripts/check-regenerated.mjs && node scripts/check-seated-study.mjs && node scripts/check-seated-materials.mjs",
    "assets:legacy:export": "node scripts/export-room-objects.mjs",
    "assets:legacy:check": "node scripts/check-room-objects.mjs"
  },
  "dependencies": {
    "pixi.js": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^31.0.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
